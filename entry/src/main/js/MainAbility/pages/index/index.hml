<!--
  index.hml - Open Light 主界面（方案 C）
  层次：小品牌字 -> 大时间 -> 玻璃输入胶囊 -> 两个并排玻璃按钮。
  按下反馈：JS 每 33ms 插值更新图片宽高（Lite 无 transform scale），实现连续缩放动画。
-->
<stack class="root">
  <image class="bg" src="/common/ui/bg_light.png"></image>

  <div class="container" style="background-color: rgba(0,0,0,0);" onswipe="onSwipe">
    <text class="brand" style="color:{{brandCol}};">开源跑马灯</text>
    <text class="clock" style="color:{{mainCol}};font-size:{{clockSize}};margin-bottom:{{clockMB}};">{{clock}}</text>

    <stack class="fieldWrap" ontouchstart="pressField" ontouchend="releaseField" ontouchcancel="releaseField" onclick="openInput">
      <div class="imgLayer">
        <image class="fieldBg" src="/common/ui/field.png" style="width:{{fw}};height:{{fh}};"></image>
      </div>
      <div class="txtLayer">
        <text class="fieldTxt" style="color:{{tiColor}};font-size:{{ffs}};">{{tiText}}</text>
      </div>
    </stack>

    <div class="btnrow">
      <stack class="btnWrap" ontouchstart="pressSet" ontouchend="releaseSet" ontouchcancel="releaseSet" onclick="goSettings">
        <div class="imgLayer">
          <image class="btnBg" src="/common/ui/btnS.png" style="width:{{sw}};height:{{sh}};"></image>
        </div>
        <div class="txtLayer">
          <text class="btnTxt" style="color:{{btnTxt}};font-size:{{sfs}};">设置</text>
        </div>
      </stack>

      <stack class="btnWrapP" ontouchstart="pressStart" ontouchend="releaseStart" ontouchcancel="releaseStart" onclick="goStart">
        <div class="imgLayer">
          <image class="btnBg" src="/common/ui/btnP2.png" style="width:{{pw}};height:{{ph}};"></image>
        </div>
        <div class="txtLayer">
          <text class="btnTxt" style="color:{{pBtnTxt}};font-size:{{pfs}};">开始启动</text>
        </div>
      </stack>
    </div>
  </div>
</stack>
