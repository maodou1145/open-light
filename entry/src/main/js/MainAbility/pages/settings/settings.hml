<!--
  settings.hml - 设置主页：分类入口（文字 / 背景 / 效果），方案 C 浅色玻璃
-->
<stack class="root">
  <image class="bg" src="/common/ui/bg_light.png"></image>

  <div class="container">

    <div class="trow">
      <text class="title" style="color:{{titleCol}};">设置</text>
    </div>

    <div class="mi" style="background-color:{{miBg}};" onclick="goFont">
      <text class="mil" style="color:{{miTx}};">文字</text>
      <text class="miv" style="color:{{miVal}};">{{fontVal}}</text>
      <text class="mia" style="color:{{miArrow}};">></text>
    </div>

    <div class="mi" style="background-color:{{miBg}};" onclick="goBg">
      <text class="mil" style="color:{{miTx}};">背景</text>
      <text class="miv" style="color:{{miVal}};">{{bgVal}}</text>
      <text class="mia" style="color:{{miArrow}};">></text>
    </div>

    <div class="mi" style="background-color:{{miBg}};" onclick="goEffect">
      <text class="mil" style="color:{{miTx}};">效果</text>
      <text class="miv" style="color:{{miVal}};">{{effVal}}</text>
      <text class="mia" style="color:{{miArrow}};">></text>
    </div>

    <div class="btns">
      <div class="navb" style="background-color:{{btnBg}};" onclick="goBack"><text class="st" style="color:{{btnTxt}};">返回</text></div>
    </div>

  </div>
</stack>
