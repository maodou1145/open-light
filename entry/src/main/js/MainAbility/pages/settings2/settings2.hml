<!-- settings2.hml - 设置第 2 页（背景颜色 + 版本号） -->
<div class="container" style="background-color:{{bgColor}};">

  <text class="title">更多</text>

  <!-- 背景颜色 -->
  <div class="row">
    <text class="lbl">背景色</text>
    <text class="cur" style="color:{{bizCol}};">{{bgCurName}}</text>
    <div class="dots">
      <div class="dot" style="background-color:{{bgdC0}};border-color:{{bgdR0}};" onclick="onBg(0)"></div>
      <div class="dot" style="background-color:{{bgdC1}};border-color:{{bgdR1}};" onclick="onBg(1)"></div>
      <div class="dot" style="background-color:{{bgdC2}};border-color:{{bgdR2}};" onclick="onBg(2)"></div>
      <div class="dot" style="background-color:{{bgdC3}};border-color:{{bgdR3}};" onclick="onBg(3)"></div>
      <div class="dot" style="background-color:{{bgdC4}};border-color:{{bgdR4}};" onclick="onBg(4)"></div>
      <div class="dot" style="background-color:{{bgdC5}};border-color:{{bgdR5}};" onclick="onBg(5)"></div>
      <div class="dot" style="background-color:{{bgdC6}};border-color:{{bgdR6}};" onclick="onBg(6)"></div>
      <div class="dot" style="background-color:{{bgdC7}};border-color:{{bgdR7}};" onclick="onBg(7)"></div>
      <div class="dot" style="background-color:{{bgdC8}};border-color:{{bgdR8}};" onclick="onBg(8)"></div>
    </div>
  </div>

  <!-- 版本号（与背景色拉开间距） -->
  <div class="row" style="margin-top:14px;">
    <text class="lbl">版本号</text>
    <text class="cur" style="color:{{bizCol}};">V3.0</text>
  </div>

  <div class="btns">
    <div class="navb" style="background-color:{{bizCol}};width:300px;" onclick="goBack"><text class="st" style="color:#FFFFFF;">返回</text></div>
  </div>

</div>