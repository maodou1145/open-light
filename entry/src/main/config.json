{
  "app": {
    "bundleName": "com.maodou.openlight",
    "vendor": "example",
    "version": { "code": 4010000, "name": "4.1.0" }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [ "liteWearable", "wearable" ],
    "distro": { "deliveryWithInstall": true, "moduleName": "entry", "moduleType": "entry" },
    "reqPermissions": [
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "键盘按键的震动反馈",
        "usedScene": { "when": "inuse" }
      },
      {
        "name": "ohos.permission.INTERNET",
        "reason": "局域网同步文字与配置（配套手机端）",
        "usedScene": { "when": "inuse" }
      }
    ],
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "MainAbility",
        "icon": "$media:icon",
        "description": "$string:OR_desc",
        "label": "$string:OR_label",
        "type": "page"
      }
    ],
    "js": [
      {
        "pages": [
          "pages/welcome/welcome",
          "pages/index/index",
          "pages/settings/settings",
          "pages/settings_font/settings_font",
          "pages/settings_bg/settings_bg",
          "pages/settings_effect/settings_effect",
          "pages/colorpicker/colorpicker",
          "pages/run/run",
          "pages/keyboard_circle/keyboard",
          "pages/keyboard_rect/keyboard"
        ],
        "name": ".MainAbility"
      }
    ]
  }
}